{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "island",
  "description": "Dynamic island window: renders player state, sends commands to main",
  "windows": ["island"],
  "permissions": [
    "core:default",
    "core:event:default",
    "store:default",
    "allow-island-set-hit-rect",
    "allow-island-get-state",
    "allow-proxy-fetch"
  ]
}
