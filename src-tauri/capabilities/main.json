{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Main window: full UI and audio engine",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-close",
    "core:window:allow-hide",
    "core:window:allow-show",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "core:event:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-register-all",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-unregister-all",
    "global-shortcut:allow-is-registered",
    "store:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://soundcloud.com/*" }, { "url": "https://*.soundcloud.com/*" }]
    },
    "updater:default",
    "process:allow-restart",
    "allow-vk-api",
    "allow-proxy-fetch",
    "allow-session-status",
    "allow-session-login",
    "allow-session-logout",
    "allow-sc-status",
    "allow-sc-login",
    "allow-sc-logout",
    "allow-sc-api",
    "allow-sc-stream",
    "allow-set-user-agent",
    "allow-media-update",
    "allow-search-open",
    "allow-clipboard-invite-code",
    "allow-set-close-to-tray",
    "allow-import-wallpaper",
    "allow-list-wallpapers",
    "allow-delete-wallpaper",
    "allow-journal-write",
    "allow-journal-tail",
    "allow-journal-open-dir",
    "allow-app-quit"
  ]
}
